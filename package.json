{
  "name": "bookhost-control-plane",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "next dev",
    "dev:live-edit": "node scripts/build-live-edit-embed.mjs && node scripts/build-server.mjs && NODE_ENV=development node live-edit-server.js",
    "build": "npm run typecheck && node scripts/build-live-edit-embed.mjs && next build && node scripts/build-server.mjs",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint . && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "stats": "node scripts/stats.mjs",
    "migrate": "node scripts/migrate.mjs",
    "eval:intake": "node eval/run.mjs"
  },
  "dependencies": {
    "@hocuspocus/provider": "^4.7.0",
