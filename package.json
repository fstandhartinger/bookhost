    "htmlparser2": "^12.0.0",
    "lowlight": "^3.3.0",
    "mammoth": "^1.12.2",
    "next": "^15.5.12",
    "next-auth": "beta",
    "nodemailer": "^7.0.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sanitize-html": "^2.17.7",
    "stripe": "^18.5.0",
