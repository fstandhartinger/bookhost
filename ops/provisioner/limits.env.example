# Operator configuration. Copy to limits.env; that file is intentionally untracked
# so a release checkout never fights with local operator values.
MAX_TENANTS=15
RESERVED_TEST_PREFIXES=rc-,fb-,nh-,dom-,bh-,tmp-,test-
TENANT_DOMAIN=wissen.app.mintapis.com

# Explicit opt-in for hot nightly backups with cold fallback.
NIGHTLY_HOT=0

# Admission only: GB is GiB (1024^3 bytes). At MAX_DISK_PERCENT reject new tenants.
MIN_FREE_DISK_GB=20
MAX_DISK_PERCENT=85
# Watchdog stays green with visible warning until DISK_FAIL_PERCENT.
DISK_WARN_PERCENT=80
DISK_FAIL_PERCENT=90
